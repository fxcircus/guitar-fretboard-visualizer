{
  "name": "guitar-fretboard-visualizer",
  "private": true,
  "version": "1.0.0",
  "description": "An open-source fretboard visualizer for alternate tunings — lap steel, pedal steel, open, drop, artist and world-instrument tunings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fxcircus/guitar-fretboard-visualizer.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:embed": "tsc -b && vite build --config vite.config.embed.ts",
    "sync:vg800": "npm run build:embed && mkdir -p ../vg800_midi_control/fretboard && cp dist-embed/fretboard-embed.es.js ../vg800_midi_control/fretboard/",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tunings": "node scripts/build-tunings.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.4"
  }
}
